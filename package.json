{
  "name": "wrathbench",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "sdk",
    "runner",
    "wiki",
    "minimap",
    "dashboard"
  ],
  "engines": {
    "bun": "1.4.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "for p in sdk runner infra dashboard dashboard/worker wiki minimap; do tsc --noEmit -p $p || exit 1; done",
    "docs:api": "bun run sdk/generate-api-docs.ts",
    "dashboard:dev": "bun run --cwd dashboard dev",
    "dashboard:build": "bun run --cwd dashboard build",
    "viewer": "bun runner/viewer/serve.ts",
    "sync-prices": "bun infra/sync-prices.ts",
    "model-logos": "bun infra/fetch-model-logos.ts",
    "docs:api:check": "bun run sdk/generate-api-docs.ts && git diff --exit-code -- sdk/API.md",
    "deploy:worldserver": "./infra/k8s-deploy.sh",
    "deploy:worldserver:compose": "./infra/deploy-worldserver.sh",
    "publisher:restart": "kubectl -n wrathbench rollout restart deployment/wrathbench-publisher",
    "publisher:restart:compose": "docker compose -f infra/compose.yml --profile publish restart publisher",
    "viewer:restart": "./infra/viewer-restart.sh",
    "tiles:publish": "bun infra/publish-tiles.ts --upload",
    "ship": "./infra/deploy-dashboard.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260825.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/bun": "1.4.0",
    "typescript": "7.0.2",
    "wrangler": "4.125.0"
  }
}
