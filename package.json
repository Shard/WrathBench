{
  "name": "wrathbench",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "wrath-mcp/sdk",
    "wrath-mcp/mcp",
    "wrath-mcp/inspector",
    "runner",
    "viewer",
    "wiki",
    "minimap",
    "dashboard",
    "collector"
  ],
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "test": "bun runner/test/preload-checkout.ts && bun test --parallel=8 --no-isolate --timeout=20000",
    "wb": "bun infra/wb.ts",
    "typecheck": "for p in wrath-mcp/sdk wrath-mcp/mcp wrath-mcp/inspector runner viewer infra dashboard wiki minimap collector; do tsc --noEmit -p $p || exit 1; done",
    "dashboard:dev": "bun run --cwd dashboard dev",
    "dashboard:build": "bun run --cwd dashboard build",
    "viewer": "bun viewer/serve.ts",
    "boundary": "bun infra/stack-boundary.ts",
    "publisher:restart": "kubectl -n wrathbench rollout restart deployment/wrathbench-publisher",
    "ship": "bun infra/wb.ts site ship"
  },
  "dependencies": {
    "@wrathbench/inspector": "workspace:*",
    "@wrathbench/mcp": "workspace:*",
    "@wrathbench/sdk": "workspace:*"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2",
    "wrangler": "4.160.0"
  }
}
