# Copy to .env (gitignored) and fill in. Nothing here is required to build or
# test; keys are only needed for real model runs via runner/.

# OpenRouter (https://openrouter.ai) — free and paid hosted models.
OPENROUTER_KEY=

# DeepSeek direct API key — only used by the opt-in V4.1 beta example.
DEEPSEEK_KEY=

# OpenCode gateway key (opencode subscription models).
OPENCODE_KEY=

# Claude subscription driver for shakeout runs (never scored runs):
# generate with `claude setup-token`. See docs/decisions + runner/README.md.
CLAUDE_CODE_OAUTH_TOKEN=

# Module port secret (module/PROTOCOL.md "Authentication"; docs/OPERATIONS.md
# "Secrets"). Required: without it the worldserver's control module refuses to
# listen. At least 32 characters; generate with `openssl rand -hex 32`.
WRATHBENCH_MODULE_SECRET=

# Optional overrides (defaults in infra/compose.yml):
# WRATHBENCH_DB_ROOT_PASSWORD=
# WRATHBENCH_ACCOUNT_USER=
# WRATHBENCH_ACCOUNT_PASSWORD=

# The public site's own https origin, no trailing slash — the social card's
# og:image has to be an absolute URL and only the build knows the hostname
# (infra/deploy-dashboard.sh, docs/PUBLIC-DASHBOARD.md "The social card").
WRATHBENCH_PUBLIC_ORIGIN=
