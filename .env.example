# Copy to .env (gitignored) and fill in. Nothing here is required to build or
# test; keys are only needed for real model runs via runner/.

# OpenRouter (https://openrouter.ai) — free and paid hosted models.
OPENROUTER_KEY=

# OpenCode gateway key (opencode subscription models).
OPENCODE_KEY=

# Claude subscription driver for shakeout runs (never scored runs):
# generate with `claude setup-token`. See docs/decisions + runner/README.md.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional overrides (defaults in infra/compose.yml):
# WRATHBENCH_DB_ROOT_PASSWORD=
# WRATHBENCH_ACCOUNT_USER=
# WRATHBENCH_ACCOUNT_PASSWORD=
