# Copy to .env (gitignored) and fill in. Nothing here is required to build or
# test — `bun test` and `bun run typecheck` are green from a bare clone with no
# `.env` at all. These are the variables an operator sets to RUN things: model
# runs via runner/, the stack via infra/compose.yml, and the public site.
#
# Bun autoloads the repo-root `.env` per process, in the container too (the
# compose services bind-mount the repo), which is why credentials live here and
# never in argv, compose or the chart. Values the chart injects on the cluster
# come from the `wrathbench-env` Secret instead; see docs/RUNBOOK.md,
# "Secrets", and infra/chart/wrathbench/values.yaml (`modelKeys`).
#
# Everything below is empty on purpose. Nothing in this file is a real value.

# ---------------------------------------------------------------- model keys
# The names a fleet roster entry may point `apiKeyEnv` at, and the names the
# chart forwards. A lane whose key is absent fails its own preflight.

# OpenRouter (https://openrouter.ai) — free and paid hosted models. The default
# `apiKeyEnv` for an openai-driver entry.
OPENROUTER_KEY=

# OpenCode gateway key (opencode subscription models).
OPENCODE_KEY=

# Cerebras key (https://cerebras.ai), for roster entries on that apiBase.
CEREBRAS_KEY=

# LM Studio (or any OpenAI-compatible server on the operator's own hardware).
# Often any non-empty string; the server decides.
LMSTUDIO_KEY=

# Claude subscription lanes for the claude-code driver — generate each with
# `claude setup-token`. Lane names go in the fleet config's
# `policy.subscriptions`; the tokens stay here. See runner/README.md.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CODE_OAUTH_TOKEN_2=

# The ChatGPT/codex lane. Not a token: the path to a logged-in Codex CLI home
# directory (`codex login` writes it). runner/README.md, "The codex lane".
CODEX_HOME=

# Optional: default base URL for the openai driver when a run passes no
# --api-base and its roster entry names none.
OPENAI_BASE_URL=

# ------------------------------------------------------------ world + module
# Module port secret (module/PROTOCOL.md "Authentication"; docs/RUNBOOK.md
# "Secrets"). Required for a live stack: without it the worldserver's control
# module refuses to listen. At least 32 characters; generate with
# `openssl rand -hex 32`.
WRATHBENCH_MODULE_SECRET=

# Optional: where the module's HTTP bridge is, when it is not the compose
# default (http://worldserver:8086). A host-side probe needs the published port.
WRATHBENCH_MODULE_URL=

# Optional: the same endpoint for the smokes (infra/smoke/lib/module.ts), as a
# host and a port rather than a URL. Either one set wins over
# WRATHBENCH_MODULE_URL; unset both and a smoke talks to worldserver:8086 on
# the container network, which is what it wants from inside the runner.
MODULE_HOST=
MODULE_PORT=

# Optional: the namespace and Helm release the cluster scripts drive
# (infra/k8s-deploy.sh, infra/k8s-release.sh, infra/fleet-update.sh,
# infra/module-health.sh). Both default to `wrathbench`.
WRATHBENCH_K8S_NAMESPACE=
WRATHBENCH_K8S_RELEASE=

# Optional overrides for the bootstrap credentials (defaults in
# infra/compose.yml; the harness accounts never carry GM).
WRATHBENCH_DB_ROOT_PASSWORD=
WRATHBENCH_ACCOUNT_USER=
WRATHBENCH_ACCOUNT_PASSWORD=

# Operator-only: the password for the GM inspection account created by
# `infra/spectator-account.ts`. There is deliberately no default; the script
# refuses to run without one, and it is never run unattended.
WRATHBENCH_SPECTATOR_PASSWORD=

# --------------------------------------------------------------- the viewer
# Optional. The private viewer binds loopback unless this is 1 (runner/viewer).
WRATHBENCH_VIEWER_LAN=

# The viewer's URL on the cluster, for infra/viewer-restart.sh's health check.
WRATHBENCH_VIEWER_URL=

# Optional: viewer port, default 8090.
WRATHBENCH_VIEWER_PORT=

# Optional: 1 serves every JSON body through the public projection — the
# projection boundary the published snapshot uses, exercised locally.
WRATHBENCH_VIEWER_PUBLIC=

# Optional: 1 serves minimap tiles from the viewer in public mode.
WRATHBENCH_VIEWER_TILES_PUBLIC=

# Optional: tile root, default data/minimap (minimap/ writes it).
WRATHBENCH_MINIMAP_DIR=

# Optional: the origin `bun run dashboard:dev` proxies /api to, default
# http://127.0.0.1:8090.
WRATHBENCH_VIEWER_ORIGIN=

# ------------------------------------------------- the public site (optional)
# Only needed to publish; see docs/PUBLIC-DASHBOARD.md and
# infra/cloudflare/README.md.

# The R2 key pair and bucket the publisher writes to. These are Bun.S3Client's
# own variable names, which is why they are unprefixed. S3_ENDPOINT is
# https://<cloudflare-account-id>.r2.cloudflarestorage.com.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT=

# The data hostname the published SPA reads snapshots from, no trailing slash
# (infra/deploy-dashboard.sh refuses to build without it).
WRATHBENCH_SNAPSHOT_BASE=

# The host holding the `tiles/` prefix. Unset builds the grid-only map.
WRATHBENCH_TILES_BASE=

# The public site's own https origin, no trailing slash — the social card's
# og:image has to be an absolute URL and only the build knows the hostname.
WRATHBENCH_PUBLIC_ORIGIN=

# Optional: the public repository URL the site links to. Unset means no link.
WRATHBENCH_REPO_URL=

# A Cloudflare API token with Workers Scripts:Edit on the account and Workers
# Routes:Edit on the zone. Unset falls back to wrangler's browser login. It
# needs no R2 permission: the publisher's key pair above is separate.
WRATHBENCH_CF_DEPLOY_TOKEN=

# ------------------------------------------- the derived store (collector/)
# Optional. Compose passes these through to ClickHouse and the collector; set
# them only to move off the compose defaults.
WRATHBENCH_CLICKHOUSE_USER=
WRATHBENCH_CLICKHOUSE_PASSWORD=

# Optional: the collector's own coordinates when it runs outside compose
# (defaults http://127.0.0.1:8123, default, empty, wrathbench).
CLICKHOUSE_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=

# ---------------------------------------------------- build/ops (optional)
# The uid/gid the images run as, when the operator's is not 1000 (infra/README).
WRATHBENCH_UID=
WRATHBENCH_GID=

# The image registry `infra/build-images.sh` pushes to, default
# harbor.local/library.
WRATHBENCH_REGISTRY=
