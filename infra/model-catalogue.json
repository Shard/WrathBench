{
  "_notes": [
    "The model catalogue: one entry per model id the fleet has used, holding every static fact the repository keeps",
    "about it. Read only through infra/model-catalogue.ts (lookup rules, types and the validator are there).",
    "Not the roster: roster/<name> in the config store is scheduling config and names a model here by its id.",
    "models: keyed by the id the fleet ran, written as the catalogue compares ids (lowercase, no ':free').",
    "  family: a families id (logo, brand, company), or null when the developer is not known.",
    "  name: the model's own name. weights: open | closed | unknown, required unless the family states one for all",
    "  its models; source: where the verdict or attribution was checked. aliases: other spellings of the same model",
    "  (a codex slug, a dated snapshot, a Zen '-free' id, an id a provider reported serving); identity only, never prices.",
    "  prices.openrouter: OpenRouter id -> rate windows, written by infra/sync-prices.ts (bun wb data prices); an empty",
    "  list is an id OpenRouter stopped pricing, 'delisted' says why it never will again.",
    "  prices.anthropic: Anthropic list price by the served ids (ids, default the key), by hand, dated; or 'unpriced'.",
    "  prices.endpoints: provider -> a metered endpoint's price, matched on the run's apiBase and the ids, by hand.",
    "Rate windows are dollars per million tokens, oldest first; the first has no 'from', later ones the day they began.",
    "providers: who a price row is from; an endpoint provider's apiBase, on-screen label, source and default note.",
    "families: file order is the precedence for an id no entry lists, matched by glob ('*' any characters).",
    "icons pins the logo source (@lobehub/icons-static-svg, MIT); after editing a family's icon: bun wb data logos.",
    "This file is written in formatCatalogue's spelling, which the tests require: after a hand edit, bun wb data catalogue --format."
  ],
  "version": 2,
  "icons": { "package": "@lobehub/icons-static-svg", "version": "1.94.0" },
  "providers": {
    "openrouter": { "name": "OpenRouter", "asOf": "2026-10-20" },
    "anthropic": { "name": "Anthropic" },
    "cerebras": {
      "name": "Cerebras",
      "apiBase": "https://api.cerebras.ai/v1",
      "label": "cerebras",
      "source": "list",
      "note": "Cerebras published price, verified 2026-09-04; no cache discount, so every prompt token bills at the input rate; metered against the operator's Cerebras balance"
    },
    "opencode-go-zen": {
      "name": "OpenCode Go (its older base)",
      "apiBase": "https://opencode.ai/zen/go/v1",
      "label": "opencode-go",
      "source": "catalogue"
    },
    "deepseek": { "name": "DeepSeek", "apiBase": "https://api.deepseek.com/v1", "label": "deepseek", "source": "list" },
    "opencode-go": {
      "name": "OpenCode Go",
      "apiBase": "https://opencode.ai/inference/go/openai/v1",
      "label": "opencode-go",
      "source": "catalogue",
      "note": "models.dev registry listing for the opencode-go provider, read {asOf}. The Go endpoint reports no per-response charge, and its usage limits are denominated in dollars, so this list rate is the expected figure for what a run draws against them, not an invoice. Append a dated window when the listing moves"
    }
  },
  "families": [
    {
      "id": "claude",
      "name": "Claude",
      "company": "Anthropic",
      "icon": "claude-color",
      "match": ["anthropic/*", "claude*", "opus*", "sonnet*", "haiku*"],
      "weights": "closed",
      "source": "Anthropic publishes no model weights; every Claude model is served only"
    },
    { "id": "openai", "name": "GPT", "company": "OpenAI", "icon": "openai", "match": ["openai/*", "gpt*"] },
    { "id": "gemini", "name": "Gemini", "company": "Google", "icon": "gemini-color", "match": ["google/*", "gemini*", "gemma*"] },
    { "id": "deepseek", "name": "DeepSeek", "company": "DeepSeek", "icon": "deepseek-color", "match": ["deepseek/*", "deepseek*"] },
